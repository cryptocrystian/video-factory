# ============================
# VIDEO FACTORY RUNTIME
# ============================

# Factory guardrails
FACTORY_NAMESPACE=video_factory
WORKFLOW_PREFIX=VF -

# n8n
N8N_BASE_URL=
N8N_API_KEY=

# Supabase / Postgres
VIDEO_FACTORY_DB_SCHEMA=video_factory
VIDEO_FACTORY_DB_URL=

# Optional Supabase HTTP API access
VIDEO_FACTORY_SUPABASE_URL=
VIDEO_FACTORY_SUPABASE_SECRET_KEY=

# Production provider APIs
FAL_KEY=
KIE_API_KEY=

# Optional direct narration provider
ELEVENLABS_API_KEY=

# Optional reasoning / scripting provider
OPENAI_API_KEY=

# Runtime
NODE_ENV=production

# Higgsfield is intentionally NOT configured here.
# It is used interactively through MCP for prototyping/comparison only,
# not as a production API dependency for the Video Factory.
